{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offgridpi.local/schema/software-components.schema.json",
  "title": "Offgrid Pi Software Components Register",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "register_id",
    "title",
    "description",
    "project",
    "packages"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "register_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/package"
      }
    }
  },
  "$defs": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "license_expression",
        "license_file",
        "copyright_notice"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "license_expression": {
          "type": "string",
          "minLength": 1
        },
        "license_file": {
          "type": "string",
          "pattern": "^LICENSE$"
        },
        "copyright_notice": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "display_name",
        "package_name",
        "purpose",
        "homepage",
        "version_source",
        "license_summary",
        "copyright_file",
        "source_information",
        "required"
      ],
      "properties": {
        "component_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "package_name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9+.-]*$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "homepage": {
          "type": "string",
          "pattern": "^https://"
        },
        "version_source": {
          "const": "dpkg-query"
        },
        "license_summary": {
          "type": "string",
          "minLength": 1
        },
        "copyright_file": {
          "type": "string",
          "pattern": "^/usr/share/doc/[a-z0-9][a-z0-9+.-]*/copyright$"
        },
        "source_information": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        }
      }
    }
  }
}
