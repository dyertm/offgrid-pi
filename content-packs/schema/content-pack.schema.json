{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offgridpi.local/schema/content-pack.schema.json",
  "title": "Offgrid Pi Content Pack Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "pack_id", "name", "version",
    "description", "category", "status", "language",
    "region", "estimated_download_bytes",
    "estimated_installed_bytes", "items"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "status": {
      "type": "string",
      "enum": ["draft", "published", "deprecated"]
    },
    "language": {"type": "string", "minLength": 2},
    "region": {"type": "string", "minLength": 1},
    "estimated_download_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "estimated_installed_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id", "title", "content_type", "source_url",
        "source_page", "source_version", "license",
        "redistribution", "size_bytes", "sha256",
        "destination", "required", "notes"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "title": {"type": "string", "minLength": 1},
        "content_type": {
          "type": "string",
          "enum": [
            "document", "zim", "map",
            "media", "archive", "other"
          ]
        },
        "source_url": {"type": "string", "format": "uri"},
        "source_page": {"type": "string", "format": "uri"},
        "source_version": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "redistribution": {
          "type": "string",
          "enum": [
            "unknown", "permitted",
            "restricted", "prohibited"
          ]
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^$|^[0-9a-fA-F]{64}$"
        },
        "destination": {
          "type": "string",
          "pattern": "^/srv/offgridpi/content/(kiwix|documents/public)/.+$"
        },
        "required": {"type": "boolean"},
        "notes": {"type": "string"}
      }
    }
  }
}
