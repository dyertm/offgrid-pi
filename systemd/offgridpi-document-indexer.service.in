[Unit]
Description=Offgrid Pi Automatic Document Indexer
After=local-fs.target
Before=offgridpi-documents.service
ConditionPathIsDirectory=/srv/offgridpi/content/documents/public
ConditionPathExists=/opt/offgridpi/scripts/watch-documents.sh

[Service]
Type=simple
User=@ADMIN_USER@
Group=offgridpi
ExecStart=/opt/offgridpi/scripts/watch-documents.sh
Restart=always
RestartSec=5
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/offgridpi/content/documents/public
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
