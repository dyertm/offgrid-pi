[Unit]
Description=Offgrid Pi Kiwix Server
After=local-fs.target
RequiresMountsFor=/srv/offgridpi/content/kiwix
ConditionPathExists=/opt/offgridpi/scripts/start-kiwix.sh

[Service]
Type=simple
User=offgridpi
Group=offgridpi
WorkingDirectory=/srv/offgridpi/content/kiwix
ExecStart=/opt/offgridpi/scripts/start-kiwix.sh
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/srv/offgridpi/content/kiwix
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
