[Unit]
Description=Offgrid Pi localhost management viewer
After=local-fs.target offgridpi-log-publisher.service
Wants=offgridpi-log-publisher.service
ConditionFileIsExecutable=/opt/offgridpi/scripts/offgridpi-management-server.py
ConditionPathExists=/var/lib/offgridpi/management/system-logs.json

[Service]
Type=simple
User=offgridpi
Group=offgridpi
WorkingDirectory=/var/lib/offgridpi/management

Environment=OFFGRIDPI_MANAGEMENT_BIND=127.0.0.1
Environment=OFFGRIDPI_MANAGEMENT_PORT=8083
Environment=OFFGRIDPI_MANAGEMENT_LOG_SNAPSHOT=/var/lib/offgridpi/management/system-logs.json

ExecStart=/opt/offgridpi/scripts/offgridpi-management-server.py

Restart=on-failure
RestartSec=5
UMask=0077

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET

ReadOnlyPaths=/opt/offgridpi/scripts
ReadOnlyPaths=/var/lib/offgridpi/management

TimeoutStartSec=30s
TimeoutStopSec=15s

[Install]
WantedBy=multi-user.target
