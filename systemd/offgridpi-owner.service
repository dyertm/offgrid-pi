[Unit]
Description=Offgrid Pi Owner Mode bootstrap service
After=local-fs.target
ConditionFileIsExecutable=/opt/offgridpi/scripts/offgridpi-owner-server.py
ConditionPathIsDirectory=/var/lib/offgridpi/owner
ConditionPathIsDirectory=/srv/offgridpi/content/maps/user-data

[Service]
Type=simple
User=offgridpi
Group=offgridpi
WorkingDirectory=/var/lib/offgridpi/owner

Environment=OFFGRIDPI_OWNER_BIND=127.0.0.1
Environment=OFFGRIDPI_OWNER_PORT=8085
Environment=OFFGRIDPI_OWNER_STATE_ROOT=/var/lib/offgridpi/owner
Environment=OFFGRIDPI_OWNER_MAP_DATA_ROOT=/srv/offgridpi/content/maps/user-data

ExecStart=/opt/offgridpi/scripts/offgridpi-owner-server.py

Restart=on-failure
RestartSec=5
UMask=0077

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET

ReadOnlyPaths=/opt/offgridpi/scripts
ReadWritePaths=/var/lib/offgridpi/owner
ReadWritePaths=/srv/offgridpi/content/maps/user-data

TimeoutStartSec=30s
TimeoutStopSec=15s

[Install]
WantedBy=multi-user.target
