[Unit]
Description=Offgrid Pi Offline Map Reader
After=local-fs.target
ConditionFileIsExecutable=/opt/offgridpi/scripts/offgridpi-map-server.py
ConditionPathExists=/opt/offgridpi/maps/index.html
ConditionPathIsDirectory=/srv/offgridpi/content/maps/packs

[Service]
Type=simple
User=offgridpi
Group=offgridpi
WorkingDirectory=/opt/offgridpi/maps

Environment=OFFGRIDPI_MAP_BIND=0.0.0.0
Environment=OFFGRIDPI_MAP_PORT=8084
Environment=OFFGRIDPI_MAP_READER_ROOT=/opt/offgridpi/maps
Environment=OFFGRIDPI_MAP_PACK_ROOT=/srv/offgridpi/content/maps/packs

ExecStart=/opt/offgridpi/scripts/offgridpi-map-server.py

Restart=on-failure
RestartSec=5
UMask=0027

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET

ReadOnlyPaths=/opt/offgridpi/scripts
ReadOnlyPaths=/opt/offgridpi/maps
ReadOnlyPaths=/srv/offgridpi/content/maps/packs

TimeoutStartSec=30s
TimeoutStopSec=15s

[Install]
WantedBy=multi-user.target
